---
const { title, content, image, imageAlt, id, isPageTitle, imageWidth, imageHeight } = Astro.props;
const imageBase = image?.replace(/\.[^.]+$/, '');
const Heading = isPageTitle ? 'h1' : 'h2';
---

<section id={id} class:list={['section', { 'section--image': image }]}>
 <div class="section__copy">
  <Heading class="headline">{title}</Heading>
  {content && <div class="content" set:html={content} />}
  <div class="slot"><slot /></div>
 </div>
 {image && <div class="image-wrap"><picture>
  <source srcset={`/img/${imageBase}.avif`} type="image/avif" />
  <source srcset={`/img/${imageBase}.webp`} type="image/webp" />
  <img src={`/img/${image}`} alt={imageAlt || title} width={imageWidth} height={imageHeight} loading="lazy" decoding="async" />
 </picture></div>}
</section>

<style lang="scss">
@use "../assets/scss/tokens.scss" as *;

.section {
  margin-bottom: clamp(1.25rem, 3vw, 2.5rem);
  padding: clamp(1.6rem, 4vw, 3.25rem);
  border-radius: 16px;
  background: rgba(255,255,255,.86);
  scroll-margin-top: 100px;
}

.headline { margin: 0; color: $color-primary; font-size: clamp(1.75rem, 4vw, 2.65rem); line-height: 1.08; letter-spacing: -.035em; }
.content { max-width: 760px; margin-top: 1.25rem; color: $color-muted; }
.content :global(p:first-child) { margin-top: 0; }
.content :global(a) { font-weight: 700; }
.slot:not(:empty) { margin-top: 1.4rem; }
.slot :global(p) { margin: .45rem 0; }

.section--image { display: grid; padding: 0; overflow: hidden; }
.section--image .section__copy { padding: clamp(1.6rem, 4vw, 3.25rem); }
.image-wrap { width: 100%; height: clamp(340px, 70vw, 430px); min-height: 0; }
.image-wrap picture { display: block; width: 100%; height: 100%; }
.image-wrap img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center top; }

@include breakpoint('m') {
  .section--image { grid-template-columns: minmax(0, 1.3fr) minmax(300px, .7fr); align-items: center; }
  .image-wrap { width: calc(100% - 1.4rem); height: clamp(440px, 48vw, 540px); margin: 1.4rem 1.4rem 1.4rem 0; border-radius: 22px; overflow: hidden; }
}
</style>
